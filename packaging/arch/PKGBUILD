# Maintainer: Danny S <48356907+DannyS124@users.noreply.github.com>
pkgname=diskanvil
pkgver=0.5.1
pkgrel=1
pkgdesc='Disk manager for Linux that works like Windows Disk Management'
arch=('x86_64')
url='https://github.com/DannyS124/diskanvil'
license=('GPL-3.0-or-later')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libjpeg-turbo' 'libstdc++' 'openssl' 'qt6-base' 'qt6-svg' 'qt6-multimedia' 'udisks2' 'util-linux-libs' 'zstd' 'zlib' 'libarchive' 'poppler-qt6')
makedepends=('cmake' 'qt6-tools')
# It was called DiskForge up to 0.5.1.
provides=('diskforge')
conflicts=('diskforge')
replaces=('diskforge')
optdepends=(
  'exfatprogs: create exFAT volumes'
  'dosfstools: create FAT32 volumes'
  'ntfs-3g: create NTFS volumes'
  'btrfs-progs: create Btrfs volumes, and scrub them from Disk Health'
  'xfsprogs: create XFS volumes'
  'pacman-contrib: clean up the package cache in Disk Cleanup'
  'snapper: list Btrfs snapshots'
  'bubblewrap: run look-only add-ons, and Find Lost Files previews, in a read-only sandbox'
  'clamav: Scan for Viruses'
  "ffmpeg: a film's first frame in Find Lost Files previews, and a film saved at another speed from its viewer"
  'qt6-imageformats: more picture kinds in Find Lost Files previews (WebP, TIFF...)'
  'fwupd: look for drive firmware updates in Disk Health'
  'udisks2-lvm2: show LVM volume groups'
  'wimlib: Make a Windows USB from ISOs with an install.wim over 4 GB'
  "qt6-multimedia-ffmpeg: play films and songs in Find Lost Files' viewer (Qt's FFmpeg backend)"
  'smartmontools: Seagate FARM hours and more in Disk Health'
  'sqlite: browser history in What This PC Did, Firefox bookmarks in Save My Files, and repairing SQLite files'
  'mdadm: open RAID arrays and NAS drives'
  'lvm2: open LVM volumes on NAS drives'
  'efibootmgr: Boot Menu Entries, and Put DiskAnvil Live on This PC'
  'qemu-desktop: Try Starting It'
  'edk2-ovmf: Try Starting It, for UEFI drives'
  'ldmtool: open Windows dynamic disks (from the AUR)'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('fa15799a32afd502a564479164095112987e8108d9bf78757d034b7026fe6995')

build() {
  rm -rf build  # makepkg keeps src/ between builds; an old cache breaks updates
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISKANVIL_SELFTEST=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
