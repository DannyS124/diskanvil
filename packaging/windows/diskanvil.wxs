<?xml version="1.0" encoding="utf-8"?>
<!--
  DiskAnvil's Windows installer, built on Linux by msitools' wixl (msi.sh puts it together, with
  installer-ui.wxs for its pages):
  everything in Program Files\DiskAnvil, a Start menu entry, a desktop shortcut if asked for,
  and an entry in Settings > Apps to remove it again. A newer version replaces an older one.
  The upgrade code below never changes: it's how Windows knows the versions are one program.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="DiskAnvil" Manufacturer="Danny S" Version="$(var.Version)" Language="1033" Codepage="1252"
           UpgradeCode="029ca1f9-948b-49dc-9466-eb50f39cdfca">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="DiskAnvil $(var.Version)" Comments="Partitions, health and rescue for your drives" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer DiskAnvil is installed already." />
    <!-- Every file is put in, whatever the version of the one there: otherwise Windows Installer
         keeps installed files of the same version (Qt's, from one DiskAnvil to the next), then
         takes them away with the old version. Everything is DiskAnvil's own, in its own folder. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <Media Id="1" Cabinet="diskanvil.cab" EmbedCab="yes" />

    <!-- How it shows in Settings > Apps. -->
    <Icon Id="diskanvil.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="diskanvil.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DannyS124/diskanvil" />
    <Property Id="ARPHELPLINK" Value="https://github.com/DannyS124/diskanvil/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <UIRef Id="DiskAnvil_UI" />
    <!-- On unless the box on the first page (or DESKTOPSHORTCUT= on msiexec's line) says no. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="DiskAnvil" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="c9d513c3-debb-4d1d-bca4-75f2b7a733fa" Win64="yes">
        <Shortcut Id="StartMenu" Name="DiskAnvil" Description="Partitions, health and rescue for your drives"
                  Target="[INSTALLFOLDER]diskanvil.exe" WorkingDirectory="INSTALLFOLDER" Icon="diskanvil.ico" />
        <RegistryValue Root="HKLM" Key="Software\DiskAnvil" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="d78b2cd6-c996-4a1d-965b-67c8181856a4" Win64="yes">
        <Condition>DESKTOPSHORTCUT</Condition>
        <Shortcut Id="Desktop" Name="DiskAnvil" Description="Partitions, health and rescue for your drives"
                  Target="[INSTALLFOLDER]diskanvil.exe" WorkingDirectory="INSTALLFOLDER" Icon="diskanvil.ico" />
        <RegistryValue Root="HKLM" Key="Software\DiskAnvil" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="DiskAnvil" Title="DiskAnvil" Level="1">
      <ComponentGroupRef Id="Files" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
