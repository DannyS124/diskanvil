<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.DannyS124.DiskAnvil</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>DiskAnvil</name>
  <summary>Disk manager and partition editor</summary>
  <developer id="io.github.dannys124">
    <name>Danny S</name>
  </developer>

  <description>
    <p>A disk manager for Linux that looks and works like Windows Disk Management.</p>
    <ul>
      <li>Mount and unmount drives</li>
      <li>Format as ext4, btrfs, NTFS, FAT32 or exFAT</li>
      <li>Create, delete and resize partitions</li>
      <li>Rename volumes and make new partition tables</li>
      <li>Disk health in plain words, with a warning when a drive is failing</li>
      <li>Back up, clone and rescue drives, and get lost partitions back</li>
      <li>Add-ons and themes</li>
    </ul>
    <p>It doesn't run as root, and the drive your system is on is locked so you can't format it by accident.</p>
  </description>

  <launchable type="desktop-id">io.github.DannyS124.DiskAnvil.desktop</launchable>
  <!-- Called DiskForge up to 0.5.1 -->
  <replaces>
    <id>io.github.DannyS124.DiskForge</id>
  </replaces>
  <provides>
    <binary>diskanvil</binary>
  </provides>

  <url type="homepage">https://github.com/DannyS124/diskanvil</url>
  <url type="bugtracker">https://github.com/DannyS124/diskanvil/issues</url>
  <url type="vcs-browser">https://github.com/DannyS124/diskanvil</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/DannyS124/diskanvil/v@PROJECT_VERSION@/docs/screenshot.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>

  <categories>
    <category>System</category>
    <category>Filesystem</category>
  </categories>
  <keywords>
    <keyword>disk</keyword>
    <keyword>partition</keyword>
    <keyword>format</keyword>
    <keyword>resize</keyword>
    <keyword>usb</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.5.2" date="2026-10-12">
      <description>
        <p>DiskForge is now called DiskAnvil; settings move over by themselves. It runs on Windows now too, with an installer. Scan for Viruses checks a drive for malware, and
        a Windows drive's startup entries, boot files and firmware too. Give New IDs lets a copied drive be used
        next to the one it was copied from.</p>
        <p>Find Lost Files brings deleted files back with their names and folders from FAT, exFAT and NTFS drives,
        finds Windows' earlier versions of a drive, opens virtual machines' disks, and previews documents, music
        and films. Also: settings for every SATA drive, NVMe sanitize, BitLocker drives, and fixes.</p>
        <p>What Happened? starts from what went wrong. Find Lost Files has a viewer, file dates and photo details,
        more file kinds, Repair a Copy, search by words, ransomware help and a timeline. Disk Health knows more about
        each drive, including Backblaze's failure rates. Also: VeraCrypt, LUKS header backups, NAS and dynamic disks,
        tools for a PC that won't start, Clonezilla restores, certificates of erasure and evidence images.</p>
        <p>DiskAnvil Live can keep changes, hold a drive for files and other ISOs, go on a PC's own drive, start
        other PCs over the network, write-protect every drive, and let someone help over the network.</p>
      </description>
    </release>
    <release version="0.5.1" date="2026-10-09">
      <description>
        <p>DiskAnvil Live: a rescue USB stick that starts any PC, new (UEFI, Secure Boot on) or old (BIOS), with DiskAnvil
        and other repair tools on a small desktop of its own. Make a DiskAnvil Live USB puts it on a stick.</p>
        <p>Find Lost Files gets deleted files back, and files from formatted or damaged drives: pictures,
        documents, videos, music and archives, with previews. Also: Check a USB Stick finds fake and failing
        sticks, Make a Windows USB, compressed images and copied files in Write Image to USB, and Quick Fixes.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-10-09">
      <description>
        <p>Disk health, writing images to USB, encrypted drives, wipe, check and repair, mount at startup,
        safely remove, disk images, benchmark, clone drives, back up and restore, rescue a failing drive, a map
        of bad and slow areas, disk usage, disk cleanup, TRIM, Btrfs snapshots, secure erase and add-ons.</p>
        <p>Also: a warning bar when a drive is failing, plain explanations in Disk Health, a firmware update
        check, Btrfs error counts and scrubs, a Stop button for wipes, recovering lost partitions, a partition
        table inspector, partition type and flags, power settings for hard drives, RAID and LVM, an Add-on
        Maker, and themes.</p>
        <p>Add-ons are safer: drive names can't steer them, look-only add-ons run in a read-only sandbox,
        risky ones always ask first, and the online add-on list is signed.</p>
      </description>
    </release>
    <release version="0.4.3" date="2026-10-08">
      <description>
        <p>Simpler wording, and Check for Updates handles there being no release.</p>
      </description>
    </release>
    <release version="0.4.2" date="2026-10-08">
      <description>
        <p>Simpler wording in the help and About window.</p>
      </description>
    </release>
    <release version="0.4.1" date="2026-10-08">
      <description>
        <p>License changed from MIT to GPL-3.0-or-later.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-08">
      <description>
        <p>About dialog, app icon, AppStream metadata and a man page.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-08">
      <description>
        <p>Shrink and grow partitions (ext4, Btrfs, NTFS, FAT32).</p>
      </description>
    </release>
  </releases>
</component>
