[Icon Theme]
Name=DiskAnvil Live
Comment=DiskAnvil Live's own icons, drawn for the stick. Anything not here comes from Breeze Dark.
Inherits=breeze-dark,breeze,hicolor
Directories=scalable/actions,scalable/apps,scalable/devices,scalable/places,scalable/status

[scalable/actions]
Size=24
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions

[scalable/apps]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/devices]
Size=24
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/places]
Size=24
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/status]
Size=24
MinSize=16
MaxSize=512
Type=Scalable
Context=Status
