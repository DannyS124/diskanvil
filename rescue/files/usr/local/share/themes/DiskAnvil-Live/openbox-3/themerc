# DiskAnvil Live's window frames, for Openbox. Colours from rescue/art/palette.txt: a navy title bar,
# a neon edge around the window in front, buttons that light up blue.

border.width: 1
padding.width: 8
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap: 0
menu.border.width: 1
osd.border.width: 1

window.active.border.color: #00e5ff
window.inactive.border.color: #1a2a4a
window.active.title.separator.color: #1a2a4a
window.inactive.title.separator.color: #1a2a4a
window.active.client.color: #0d1426
window.inactive.client.color: #0d1426

window.active.title.bg: flat solid
window.active.title.bg.color: #0d1426
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0a1020

window.active.label.bg: parentrelative
window.active.label.text.color: #e6f1ff
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #7f93b5
window.label.text.justify: center

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #9ad8ff
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1f6fff
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #00e5ff
window.active.button.pressed.image.color: #060a16
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #4d5f80
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #00e5ff
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #1f6fff
window.active.button.toggled.hover.image.color: #ffffff

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #4d5f80
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #1a2a4a
window.inactive.button.hover.image.color: #9ad8ff
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #1f6fff
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #2a3a5a
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #9ad8ff

window.active.handle.bg: flat solid
window.active.handle.bg.color: #0d1426
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #0a1020
window.active.grip.bg: flat solid
window.active.grip.bg.color: #1f6fff
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1a2a4a

menu.border.color: #1a2a4a
menu.separator.color: #1a2a4a
menu.title.bg: flat solid
menu.title.bg.color: #060a16
menu.title.text.color: #9ad8ff
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: #0d1426
menu.items.text.color: #e6f1ff
menu.items.disabled.text.color: #4d5f80
menu.items.active.bg: flat solid
menu.items.active.bg.color: #1f6fff
menu.items.active.text.color: #ffffff

osd.bg: flat solid
osd.bg.color: #0d1426
osd.border.color: #1f6fff
osd.label.text.color: #e6f1ff
osd.hilight.bg: flat solid
osd.hilight.bg.color: #00e5ff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #1a2a4a
