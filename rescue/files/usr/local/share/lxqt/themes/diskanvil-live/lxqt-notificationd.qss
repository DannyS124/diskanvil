/* Pop-up notifications (Save Logs says how it went in one of these). */
Notification {
    color: #e6f1ff;
    background: #0d1426;
    border: 1px solid #1f6fff;
    border-radius: 8px;
    margin: 0;
}

QLabel {
    color: #e6f1ff;
}

#appLabel {
    color: #9ad8ff;
    font-weight: bold;
}

#closeButton {
    border: none;
    border-radius: 4px;
    padding: 2px;
}

#closeButton:hover {
    background: #ff3355;
}
