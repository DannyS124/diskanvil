/* The run box (Alt+F2). */
#Dialog {
    color: #e6f1ff;
    background: #0d1426;
    border: 1px solid #1f6fff;
    border-radius: 8px;
}

QLineEdit {
    color: #e6f1ff;
    background: #060a16;
    border: 1px solid #1a2a4a;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #1f6fff;
}

QListView {
    color: #e6f1ff;
    background: transparent;
    border: none;
    selection-background-color: #1f6fff;
    selection-color: #ffffff;
}
