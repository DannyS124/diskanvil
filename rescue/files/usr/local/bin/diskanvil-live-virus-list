#!/bin/bash
# Keeps Scan for Viruses' list of known malware (ClamAV's signatures, about 250 MB) on the stick
# between starts. DiskAnvil uses the list from memory, /run/diskanvil-live/clamav; this copies
# it there from the stick before the first scan, and back to the stick after an update.
#
#   diskanvil-live-virus-list load    stick -> memory
#   diskanvil-live-virus-list save    memory -> stick
#
# Exits 0 when it worked (load: also when the stick has no list yet), 2 when there's no stick
# to use (started from the ISO, or written to the stick as an ISO), 1 when it went wrong.
# The stick is only writable for the moment the list is copied, like for the logs.
set -u
[ "$(id -u)" = 0 ] || exec sudo -n "$0" "$@"

. /etc/diskanvil-live.conf
state=/run/diskanvil-live
ram=$state/clamav
. /usr/local/lib/diskanvil-live/find-stick.sh

exec 9>"$state/virus-list.lock"
flock -w 600 9 || { echo "Another copy of the list is still running."; exit 1; }

stick=$(find_stick) || { echo "There's no DiskAnvil Live stick to keep the list on."; exit 2; }
done_with_stick() {
    [ "$stick" = "$state/stick" ] && umount "$stick"
}
on_stick=$stick/diskanvil-live/virus-signatures
# Where it was kept while DiskAnvil was called DiskForge (a stick updated since still has it there).
old_place=$stick/diskforge-live/virus-signatures
result=0

case ${1:-} in
load)
    mkdir -p "$ram"
    from=$on_stick
    [ -d "$from" ] || from=$old_place
    if [ -d "$from" ]; then
        cp -a "$from/." "$ram/" || { echo "Couldn't copy the list from the stick."; result=1; }
    fi
    chown -R rescue:rescue "$ram"
    ;;
save)
    if [ "$(findmnt -no FSTYPE "$stick")" != vfat ]; then
        echo "This copy of DiskAnvil Live is read-only (written as an ISO), so the list stays in memory until it shuts down."
        result=2
    elif ! mount -o remount,rw "$stick"; then
        echo "Couldn't write to the stick."
        result=1
    else
        # A new folder first, then swap: a stick pulled out halfway still has a whole list.
        rm -rf "$on_stick.new"
        if mkdir -p "$on_stick.new" && cp -r "$ram/." "$on_stick.new/"; then
            rm -rf "$on_stick.old"
            [ -d "$on_stick" ] && mv "$on_stick" "$on_stick.old"
            mv "$on_stick.new" "$on_stick" && rm -rf "$on_stick.old" "$stick/diskforge-live"
            echo "The virus list is on the stick for next time."
        else
            rm -rf "$on_stick.new"
            echo "Couldn't copy the list to the stick (is it full?). It's in memory until DiskAnvil Live shuts down."
            result=1
        fi
        sync
        mount -o remount,ro "$stick"
    fi
    ;;
*)
    echo "usage: diskanvil-live-virus-list load|save" >&2
    result=1
    ;;
esac
done_with_stick
exit $result
