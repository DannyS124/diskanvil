#!/bin/bash
# Starts the desktop on the first screen (~/.bash_profile runs this). If it won't start, it
# says so, saves the logs and leaves a text console to work in.
session=/run/diskanvil-live/session
# DiskAnvil writes its own log there, and the log saver picks it up.
export DISKANVIL_LOG=$session/diskanvil.log

for attempt in 1 2; do
    echo "== $(date '+%H:%M:%S') starting the desktop (try $attempt)" >> "$session/desktop.log"
    started=$(date +%s)
    startx /usr/bin/startlxqt -- -keeptty "vt${XDG_VTNR:-1}" >> "$session/desktop.log" 2>&1
    # A desktop that ran for a while was closed on purpose (Log Out).
    if [ $(($(date +%s) - started)) -gt 30 ]; then
        echo
        echo "The desktop is closed. Type startx to open it again, or poweroff to turn the PC off."
        exit 0
    fi
done

clear
cat <<TEXT
The desktop didn't start. Sorry about that.

What usually helps: restart (type reboot) and pick "Safe graphics" in the boot
menu.

The details are going to the stick now, in its logs folder.
TEXT
diskanvil-live-logs
echo
diskanvil-live-welcome --short
