#!/bin/bash
# For a drive plugged in while the PC is on. DiskAnvil runs this through sudo from Secure Erase's
# Unplug and Replug, on DiskAnvil Live only.
#
#   diskanvil-live-rescan scan          ask every disk controller to look for drives again
#   diskanvil-live-rescan detach sdX    let go of a drive before it's unplugged (writes out its
#                                       cache and spins it down)
case "${1:-}" in
scan)
    # Some controllers (USB, NVMe) don't take it and say "Invalid argument"; that's fine.
    for scan in /sys/class/scsi_host/host*/scan; do
        echo "- - -" > "$scan" 2>/dev/null
    done
    ;;
detach)
    name=${2:-}
    [[ $name =~ ^sd[a-z]{1,3}$ ]] || { echo "not a drive name: $name" >&2; exit 2; }
    [ -e "/sys/block/$name/device/delete" ] || { echo "no such drive: $name" >&2; exit 2; }
    if lsblk -nro MOUNTPOINT "/dev/$name" | grep -q .; then
        echo "$name is still in use" >&2
        exit 3
    fi
    sync
    echo 1 > "/sys/block/$name/device/delete"
    ;;
*)
    echo "usage: diskanvil-live-rescan scan | detach sdX" >&2
    exit 2
    ;;
esac
