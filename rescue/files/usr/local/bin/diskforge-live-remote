#!/bin/bash
# DiskForge Live's remote help, the part that needs root: a terminal for someone else over SSH,
# with a password made up for this time only. Off unless switched on in DiskForge (Tools > Let
# Someone Help); switched off, SSH stops and the live user has no password again, as it started.
# (The screen, x11vnc, runs as the live user, from DiskForge itself.)
#
#   diskforge-live-remote ssh-on     the password on stdin
#   diskforge-live-remote ssh-off
#   diskforge-live-remote status     "on" or "off"
set -u
user=rescue
case "${1:-}" in
ssh-on)
    IFS= read -r password
    [ ${#password} -ge 8 ] || { echo "the password is too short" >&2; exit 2; }
    # Host keys of its own, made now: every stick made from the same ISO would share them otherwise.
    ssh-keygen -A >/dev/null || exit 1
    echo "$user:$password" | chpasswd || exit 1
    systemctl start ssh.service || exit 1
    ;;
ssh-off)
    systemctl stop ssh.service ssh.socket 2>/dev/null
    # Whoever is still logged in goes too.
    pkill -KILL -u "$user" -x sshd 2>/dev/null
    pkill -KILL -x sshd-session 2>/dev/null
    passwd --delete "$user" >/dev/null
    ;;
status)
    if systemctl is-active --quiet ssh.service; then echo on; else echo off; fi
    ;;
*)
    echo "usage: $0 ssh-on | ssh-off | status" >&2
    exit 2
    ;;
esac
